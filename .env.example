# =============================================================
# agentes_perdidos — environment template
# Copy to .env and fill. NEVER commit .env (it's gitignored).
# =============================================================

# --- image-creator agent ---

# OpenAI (used for TRANSPARENT images: logos, mascots, icons, sprites).
# Needs org verification to unlock image endpoints.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini "Nano Banana" (used for NORMAL / photographic / scene images:
# backgrounds, banners, hero art).
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Kling AI (Kuaishou) — access key + secret pair (JWT auth).
# Strong at VIDEO (image-to-video, text-to-video) and an extra image route.
# Used as a fallback and for video tasks. https://app.klingai.com (API console)
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# --- bucket agent (offload static assets to object storage) ---
# Backblaze B2 (S3-compatible). The bucket must be PUBLIC to serve files in a browser.
B2_S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_ID=
B2_BUCKET_NAME=                 # leave blank to auto-resolve if the key is bucket-scoped
B2_PUBLIC_BASE_URL=            # e.g. https://f005.backblazeb2.com/file/<bucket> or a custom domain
# Cloudflare R2 (S3-compatible). Best for hot, browser-served assets (free egress + CDN).
R2_S3_ENDPOINT=               # https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=           # https://<pub-id>.r2.dev or a custom domain

# --- Optional model overrides (defaults baked into the skill) ---
# Override only if a newer model ships or your tier differs.
# OPENAI_IMAGE_MODEL=gpt-image-2          # general / opaque OpenAI route
# OPENAI_IMAGE_MODEL_TRANSPARENT=gpt-image-1.5   # transparency-capable route
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image      # Nano Banana
# GEMINI_VISION_MODEL=gemini-2.5-flash    # lost-finder `verify` stage (image yes/no screening)
# KLING_IMAGE_MODEL=kling-v2               # Kling image model
# KLING_API_BASE=https://api-singapore.klingai.com  # regional API base
