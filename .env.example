# =============================================================
# agentes_perdidos — environment template
# Copy to .env and fill. NEVER commit .env (it's gitignored).
# =============================================================

# --- image-creator agent ---

# OpenAI (used for TRANSPARENT images: logos, mascots, icons, sprites).
# Needs org verification to unlock image endpoints.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini "Nano Banana" (used for NORMAL / photographic / scene images:
# backgrounds, banners, hero art).
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Kling AI (Kuaishou) — access key + secret pair (JWT auth).
# Strong at VIDEO (image-to-video, text-to-video) and an extra image route.
# Used as a fallback and for video tasks. https://app.klingai.com (API console)
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# --- bucket agent (offload static assets to object storage) ---
# Backblaze B2 (S3-compatible). The bucket must be PUBLIC to serve files in a browser.
B2_S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_ID=
B2_BUCKET_NAME=                 # leave blank to auto-resolve if the key is bucket-scoped
B2_PUBLIC_BASE_URL=            # e.g. https://f005.backblazeb2.com/file/<bucket> or a custom domain
# Backblaze B2 PRIVATE bucket — personal offsite backup (NOT browser-served). Used to store
# llm-wiki/second-brain backups when a project repo can't take the brain (e.g. confidential).
B2_PRIVATE_S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_PRIVATE_REGION=us-east-005
B2_PRIVATE_KEY_ID=
B2_PRIVATE_APPLICATION_KEY=
B2_PRIVATE_KEY_NAME=
B2_PRIVATE_BUCKET_NAME=
B2_PRIVATE_BUCKET_ID=
# Cloudflare R2 (S3-compatible). Best for hot, browser-served assets (free egress + CDN).
R2_S3_ENDPOINT=               # https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=           # https://<pub-id>.r2.dev or a custom domain

# --- cloudflare agent (drive the whole Cloudflare account: R2, DNS, Workers/Pages, Turnstile, Email, cache) ---
# ONE account-owned API token with ~all permission groups is the Bearer for api.cloudflare.com/client/v4.
# A separate R2 S3-compatible key pair is for the S3 protocol (presigning + object I/O). PUBLIC repo:
# put VALUES only in .env (gitignored) — never here, never in any committed file. Get them from the
# Cloudflare dashboard: My Profile → API Tokens (token) and R2 → Manage R2 API Tokens (S3 keys).
ACCOUNT_ID_CLOUDFLARE=            # Cloudflare account id (path segment /accounts/{id}/... and R2 S3 host)
TOKEN_API_CLOUDFRARE=            # account-owned API token — Authorization: Bearer (NOTE the typo: keep this exact name)
ACCESS_KEY_CLOUDFLARE=           # R2 S3 access key id (for boto3/aws presign + object I/O)
SECRET_ACCESS_KEY_CLOUDFLARE=    # R2 S3 secret access key (pair with the access key)
S3_API_ENDPOINT_CLOUDFLARE=      # R2 S3 endpoint: https://<accountid>.r2.cloudflarestorage.com
# wrangler reads CLOUDFLARE_API_TOKEN + CLOUDFLARE_ACCOUNT_ID — export those from the two vars above at runtime.

# --- stripe agent (implement + homologate + validate Stripe) ---
# This agent works ON a target project and uses THAT project's Stripe TEST keys, which live in the
# target project's own gitignored env (.env / .env.test / application-homolog.properties), NOT here.
# The variables below are only needed if you run the agent's helper scripts standalone.
# Get keys at https://dashboard.stripe.com/test/apikeys  (TEST mode).
#
# TEST secret/restricted key — used for ALL validation (stripe_env.py refuses any *_live_ secret).
STRIPE_TEST_SECRET_KEY=          # sk_test_... or a write-scoped rk_test_...
# TEST publishable key — the frontend (loadStripe / StripeProvider) uses this.
STRIPE_TEST_PUBLISHABLE_KEY=     # pk_test_...
# LIVE *read-only restricted* key — ONLY for mirror_catalog.py's one-way live→test catalog read.
# Create a Restricted key with read-only on Products+Prices: https://dashboard.stripe.com/apikeys
# Never put a live SECRET key here. Leave blank unless mirroring a production catalog.
STRIPE_LIVE_READONLY_KEY=        # rk_live_... (read-only) — optional
# Webhook signing secret for the homologation endpoint. From `stripe listen` (local) or a TEST
# Dashboard webhook endpoint. Per-endpoint and per-mode — never the live secret.
STRIPE_TEST_WEBHOOK_SECRET=      # whsec_...
# The Stripe CLI (https://docs.stripe.com/stripe-cli) must be installed + `stripe login` run once
# for `stripe listen` / `stripe trigger`. Optionally connect the official Stripe MCP server too.

# --- navigator agent (browser-driving GUI + credential harvest) ---
# navigator drives web dashboards to do GUI work (Stripe account/products/keys/webhooks/portal,
# Coolify/Dokploy env) and HARVESTS credentials. These vars only point at the browser BACKENDS —
# they hold NO secrets. Harvested Stripe keys/IDs are written by secrets_writer.py into the TARGET
# project's gitignored .env, NEVER here. (secrets_writer.py refuses any path inside this repo.)
CHROME_REMOTE_DEBUG_URL=http://127.0.0.1:9222   # Tier 2: chrome-devtools-mcp attach target (warm Chrome --remote-debugging-port)
CAMOFOX_URL=                                     # Tier 3: hermes Camofox REST base, e.g. http://localhost:9377 (optional, anti-detect)
BROWSER_CDP_URL=                                 # Tier 3: hermes raw-CDP endpoint (optional)
HERMES_VPS_HOST=<your-vps-ip>                   # Tier 3 fallback: hermes on oracle-vps (Dokploy). Reachability probe only.

# --- social-auth agent (Google + Facebook login into the existing user system) ---
# This agent works ON a target project and uses THAT project's OAuth credentials, which live in
# the target project's own gitignored env (.env / application*.properties / EXPO_PUBLIC_*), NOT here.
# Nothing is required here to run the agent. The canonical var NAMES the agent wires per project
# (set the VALUES in the target project, harvested by navigator) are:
#   Backend (SECRET — never in a VITE_/REACT_APP_/EXPO_PUBLIC_ var):
#     GOOGLE_CLIENT_ID / GOOGLE_OAUTH_CLIENT_ID, GOOGLE_CLIENT_SECRET / GOOGLE_OAUTH_CLIENT_SECRET
#     FACEBOOK_APP_ID, FACEBOOK_APP_SECRET (+ optional FACEBOOK_CLIENT_TOKEN)
#     X_CLIENT_ID, X_CLIENT_SECRET            # X adapter is shipped flag-off (X_LOGIN_ENABLED=false)
#     plus the app's *_ENABLED flags (e.g. GOOGLE_OAUTH_ENABLED=true, FACEBOOK_LOGIN_ENABLED=true)
#   Frontend (PUBLIC only — client IDs, never secrets):
#     VITE_GOOGLE_CLIENT_ID / REACT_APP_GOOGLE_CLIENT_ID / EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID, VITE_FACEBOOK_APP_ID
# Get them from: Google Auth Platform (https://console.cloud.google.com/auth/clients) and
# Meta for Developers (https://developers.facebook.com/apps/). navigator creates + harvests them.

# --- captcha agent (Google reCAPTCHA primary; Cloudflare Turnstile alt) ---
# Same model: keys live in the TARGET project's gitignored env, not here. Canonical names:
#   Backend (SECRET):  RECAPTCHA_SECRET_KEY (+ RECAPTCHA_V2_SECRET_KEY for the fallback)
#   Frontend (PUBLIC): RECAPTCHA_SITE_KEY / VITE_RECAPTCHA_SITE_KEY / REACT_APP_RECAPTCHA_SITE_KEY
#   Flag: RECAPTCHA_ENABLED=true   (Turnstile alt: TURNSTILE_SITE_KEY / TURNSTILE_SECRET_KEY)
# Get them from: reCAPTCHA admin (https://www.google.com/recaptcha/admin/create). The agent's
# Lane-A harness uses the providers' public TEST keys (no real solving) — no values needed here.

# --- Optional model overrides (defaults baked into the skill) ---
# Override only if a newer model ships or your tier differs.
# OPENAI_IMAGE_MODEL=gpt-image-2          # general / opaque OpenAI route
# OPENAI_IMAGE_MODEL_TRANSPARENT=gpt-image-1.5   # transparency-capable route
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image      # Nano Banana
# GEMINI_VISION_MODEL=gemini-2.5-flash    # lost-finder `verify` stage (image yes/no screening)
# KLING_IMAGE_MODEL=kling-v2               # Kling image model
# KLING_API_BASE=https://api-singapore.klingai.com  # regional API base
