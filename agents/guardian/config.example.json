{
  "host_label": "coolify",
  "backup_dir": "/root/backups",
  "local_keep": 1,
  "weekly_weekday": 5,
  "b2_daily_keep": 3,
  "b2_weekly_keep": 3,
  "b2_noncurrent_days": 7,
  "weekly_copy_max_bytes": 536870912,
  "exclude_patterns": ["^[0-9a-f]{64}$", "redis"],
  "b2": {
    "endpoint": "https://s3.us-east-005.backblazeb2.com",
    "region": "us-east-005",
    "key_id": "<B2_PRIVATE_KEY_ID>",
    "application_key": "<B2_PRIVATE_APPLICATION_KEY>",
    "bucket": "<YOUR_PRIVATE_BUCKET>",
    "connect_timeout": 30,
    "read_timeout": 900,
    "max_attempts": 3
  },
  "whatsapp": {
    "api_url": "https://<your-evolution-host>",
    "instance": "<EVOLUTION_INSTANCE>",
    "api_key": "<EVOLUTION_KEY>",
    "target_number": "<COUNTRY_AREA_NUMBER>"
  }
}
